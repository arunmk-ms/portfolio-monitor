# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Where the portfolioapp Functions API lives.
# Leave as /api in development: vite.config.js proxies it to VITE_API_PROXY_TARGET,
# which keeps the browser same-origin and avoids CORS configuration.
VITE_API_BASE_URL=/api

# Dev-only: the local Functions host to proxy /api to.
VITE_API_PROXY_TARGET=http://localhost:7234

# Function key for endpoints declared with AuthorizationLevel.Function.
# Not needed against a local Functions host, which does not enforce keys.
#
# WARNING: anything prefixed with VITE_ is inlined into the built JavaScript and is
# therefore public. Do not put a production function key here. For a deployed build,
# serve the API from the same origin (Azure Static Web Apps linked backend), or put
# API Management / Easy Auth in front of it, so the browser never holds a key.
# VITE_API_FUNCTION_KEY=
