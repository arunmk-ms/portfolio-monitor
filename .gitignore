# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
# Azure Functions local settings. Also matched under bin/ so build copies of
# this file (e.g. portfolioapp.Tests/bin/.../local.settings.json) never get
# committed once a real API key is present.
local.settings.json
**/local.settings.json
!**/local.settings.sample.json

.env
.env.*
!.env.example

*.pfx
*.publishsettings
*.publishproj
*.azurePubxml
PublishScripts/

# ---------------------------------------------------------------------------
# .NET build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
BenchmarkDotNet.Artifacts/
[Tt]est[Rr]esult*/
coverage*.xml
coverage*.json
*.coverage
*.trx

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs and temp files
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.pid

# ---------------------------------------------------------------------------
# Local databases
# ---------------------------------------------------------------------------
*.mdf
*.ldf
*.ndf

# ---------------------------------------------------------------------------
# Personal data
# ---------------------------------------------------------------------------
# Real brokerage exports must never be committed. The anonymized fixture in
# portfolioapp.Tests/TestData is force-included below.
Portfolio_Positions*.csv
!portfolioapp.Tests/TestData/Portfolio_Positions*.csv
